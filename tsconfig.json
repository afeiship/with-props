{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "es2015",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "pretty": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "module": "es2015",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "es2015"
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "src",
    "__tests__"
  ]
}
